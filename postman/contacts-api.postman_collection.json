{
  "info": {
    "_postman_id": "3f6d2a3e-9e2c-4d7a-8b7f-1a2c3d4e5f60",
    "name": "Contacts API",
    "description": "Prueba técnica backend: API REST de contactos en PHP sin framework. Importa también `local.postman_environment.json` y selecciónalo antes de correr las requests.\n\nOrden sugerido: correr toda la carpeta \"Contactos\" de arriba hacia abajo (Crear guarda `contact_id` para las siguientes). La carpeta \"Casos de error\" es independiente y se puede correr en cualquier momento.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Contactos",
      "item": [
        {
          "name": "Listar contactos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/contacts",
              "host": ["{{base_url}}"],
              "path": ["api", "contacts"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('trae un arreglo de contactos', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.contacts).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Crear contacto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"{{$randomFirstName}}\",\n  \"last_name\": \"{{$randomLastName}}\",\n  \"email\": \"{{$randomEmail}}\",\n  \"company\": \"{{$randomCompanyName}}\",\n  \"favorite\": true,\n  \"phones\": [\n    { \"type\": \"mobile\", \"number\": \"+52 55 1234 5678\" },\n    { \"type\": \"work\", \"number\": \"55 8899 1020\" }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/contacts",
              "host": ["{{base_url}}"],
              "path": ["api", "contacts"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('trae el header Location', () => {",
                  "  pm.expect(pm.response.headers.has('Location')).to.be.true;",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('el teléfono queda normalizado a 10 dígitos', () => {",
                  "  pm.expect(body.contact.phones[0].number).to.match(/^\\d{10}$/);",
                  "});",
                  "",
                  "// Guarda el id para las siguientes requests de esta carpeta.",
                  "pm.environment.set('contact_id', body.contact.id);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Obtener contacto",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/contacts/{{contact_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "contacts", "{{contact_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('es el contacto creado', () => {",
                  "  pm.expect(pm.response.json().contact.id).to.eql(pm.environment.get('contact_id'));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Eliminar contacto",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/contacts/{{contact_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "contacts", "{{contact_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));",
                  "pm.test('sin cuerpo', () => pm.expect(pm.response.text()).to.eql(''));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Casos de error",
      "item": [
        {
          "name": "Crear con campos vacíos (422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"\",\n  \"last_name\": \"\",\n  \"email\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/contacts",
              "host": ["{{base_url}}"],
              "path": ["api", "contacts"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));",
                  "const body = pm.response.json();",
                  "pm.test('reporta first_name, last_name y email', () => {",
                  "  pm.expect(body.errors).to.have.all.keys('first_name', 'last_name', 'email');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Crear con email inválido (422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Test\",\n  \"last_name\": \"User\",\n  \"email\": \"no-es-un-correo\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/contacts",
              "host": ["{{base_url}}"],
              "path": ["api", "contacts"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));",
                  "pm.test('reporta el campo email', () => {",
                  "  pm.expect(pm.response.json().errors).to.have.property('email');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Crear con email duplicado (422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Test\",\n  \"last_name\": \"Duplicado\",\n  \"email\": \"{{existing_email}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/contacts",
              "host": ["{{base_url}}"],
              "path": ["api", "contacts"]
            },
            "description": "`existing_email` viene del environment y debe ser el correo de un contacto ya existente (por defecto, uno de los datos de ejemplo del seed)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));",
                  "pm.test('reporta el campo email', () => {",
                  "  pm.expect(pm.response.json().errors).to.have.property('email');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Crear con teléfono inválido (422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Test\",\n  \"last_name\": \"User\",\n  \"email\": \"{{$randomEmail}}\",\n  \"phones\": [\n    { \"type\": \"fax\", \"number\": \"123\" }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/contacts",
              "host": ["{{base_url}}"],
              "path": ["api", "contacts"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));",
                  "const errors = pm.response.json().errors;",
                  "pm.test('reporta tipo y número de teléfono', () => {",
                  "  pm.expect(errors).to.have.property('phones.0.type');",
                  "  pm.expect(errors).to.have.property('phones.0.number');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Crear con JSON malformado (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{ \"first_name\": \"Test\", ",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/contacts",
              "host": ["{{base_url}}"],
              "path": ["api", "contacts"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Consultar contacto inexistente (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/contacts/no-existe",
              "host": ["{{base_url}}"],
              "path": ["api", "contacts", "no-existe"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Eliminar contacto inexistente (404)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/contacts/no-existe",
              "host": ["{{base_url}}"],
              "path": ["api", "contacts", "no-existe"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Método no permitido (405)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/contacts",
              "host": ["{{base_url}}"],
              "path": ["api", "contacts"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 405', () => pm.response.to.have.status(405));",
                  "pm.test('trae el header Allow', () => {",
                  "  pm.expect(pm.response.headers.has('Allow')).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
