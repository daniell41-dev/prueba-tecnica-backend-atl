{
    "name": "atl/contacts-api",
    "description": "API REST de contactos en PHP puro (sin framework), prueba tecnica backend.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src public bin -name '*.php' -print0 | xargs -0 -n1 php -l",
        "migrate": "php bin/migrate.php",
        "serve": "php -S localhost:8000 -t public public/index.php"
    },
    "config": {
        "sort-packages": true
    }
}
